# Database (Supabase Postgres)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# App
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"

# Mabruk
STORE_NAME="Mabruk Semijoias"
STORE_FROM_ZIP="01310-100"
FREE_SHIPPING_THRESHOLD_CENTS=29900
MAX_INSTALLMENTS_NO_INTEREST=2

# Admin seed (apenas no primeiro boot — usado por scripts/seed)
SEED_ADMIN_EMAIL="admin@mabruk.com.br"
SEED_ADMIN_PASSWORD="Mabruk@2026"
SEED_ADMIN_NAME="Gustavo"

# Front-end (CORS)
FRONTEND_URL="http://localhost:3001"
